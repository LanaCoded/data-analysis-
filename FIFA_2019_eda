    "def standardize_contract_date(x):\n",
    "    if pd.isna(x):\n",
    "        return np.nan\n",
    "    x_str = str(x).strip()\n",
    "    if x_str.replace('.0', '').isdigit() and len(x_str.replace('.0', '')) == 4:\n",
    "        year = x_str.replace('.0', '')\n",
    "        return f\"{year}-12-31\" # Default to end of year\n",
    "    \n",
    "    try:\n",
    "        return pd.to_datetime(x_str).strftime('%Y-%m-%d')\n",
    "    except:\n",
    "        return np.nan\n",
    "\n",
    "df['contract_valid_until'] = df['contract_valid_until'].apply(standardize_contract_date)\n",
    "\n",
    "# 3. Verify clean data\n",
    "print(\"\\nCleaned Sample:\\n\", df['contract_valid_until'].dropna().head())"
   ]
